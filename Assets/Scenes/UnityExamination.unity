  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  textBox: {fileID: 1972447008}
  nextButton: {fileID: 1114371916}
  dialogue:
  - Hello Kitty! My name is Blub.
  - I have, just like you, once been stuck in this cave.
  - The seret to getting out is crossing over to the other side.
  - But it's not that simple...
  - There is a timer!!!
  - And if you run out of time before reaching the other side
  - You will be...
  - ...stuck here forever...
  - Go hurry, jump on my head to start!
  - I wish you good luck Kitty!
  onStartDialogue:
    m_PersistentCalls:
